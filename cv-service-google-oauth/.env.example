# Google Auth Platform web OAuth client
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=server-only-client-secret
GOOGLE_REDIRECT_URI=https://jobpickcv-5ouvegg7.manus.space/api/oauth/google/callback

# Public frontend return target; never accept arbitrary returnTo URLs
FRONTEND_ORIGIN=https://jobpick20.com
FRONTEND_RETURN_PATH=/tools/

# Use a strong random secret in the real backend environment for session signing/encryption.
SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000
